<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>NITEDRIVE</title>

    <organization>com.nitedriveaudio</organization>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <!-- Plug-ins belong in the system-wide folders both Live and every other host
         scan by default. Installing to the user's home instead is possible but then
         only that account sees them. -->
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <!-- Universal binaries, and JUCE 8's deployment target. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.13"/>
        </allowed-os-versions>
    </volume-check>

    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>

    <choices-outline>
        <line choice="choice.vst3"/>
        <line choice="choice.au"/>
    </choices-outline>

    <choice id="choice.vst3"
            title="VST3"
            description="Installs NITEDRIVE.vst3 into /Library/Audio/Plug-Ins/VST3. Works in Ableton Live and every other VST3 host.">
        <pkg-ref id="com.nitedriveaudio.nitedrive.vst3"/>
    </choice>

    <choice id="choice.au"
            title="Audio Unit"
            description="Installs NITEDRIVE.component into /Library/Audio/Plug-Ins/Components. Needed for Logic, and gives Live a second option.">
        <pkg-ref id="com.nitedriveaudio.nitedrive.au"/>
    </choice>

    <pkg-ref id="com.nitedriveaudio.nitedrive.vst3" version="1.0.0" onConclusion="none">NITEDRIVE-VST3.pkg</pkg-ref>
    <pkg-ref id="com.nitedriveaudio.nitedrive.au"   version="1.0.0" onConclusion="none">NITEDRIVE-AU.pkg</pkg-ref>
</installer-gui-script>
