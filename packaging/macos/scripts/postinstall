#!/bin/bash
#
# Runs as root after the bundles are in place.
#
# Two jobs: make sure a stale copy in the user's own plug-in folder cannot shadow
# or duplicate what was just installed, and nudge macOS into noticing the Audio
# Unit so it appears without a reboot.
#
# Nothing is deleted. A stale copy is renamed with a timestamp so it can be put
# back if this turns out to be the wrong call.

set -u

SYSTEM_VST3="/Library/Audio/Plug-Ins/VST3/NITEDRIVE.vst3"
SYSTEM_AU="/Library/Audio/Plug-Ins/Components/NITEDRIVE.component"

log() { echo "NITEDRIVE installer: $*"; }

# The installer runs as root, so $HOME is root's. Resolve the human actually
# logged in at the console instead.
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"

if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"

    if [ -n "${USER_HOME:-}" ] && [ -d "$USER_HOME" ]; then
        STAMP="$(date +%Y%m%d-%H%M%S)"

        for OLD in "$USER_HOME/Library/Audio/Plug-Ins/VST3/NITEDRIVE.vst3" \
                   "$USER_HOME/Library/Audio/Plug-Ins/Components/NITEDRIVE.component"; do
            if [ -e "$OLD" ]; then
                # Two copies on the scan path make the host list the plugin twice and
                # pick between them unpredictably.
                mv "$OLD" "$OLD.replaced-$STAMP"
                chown -R "$CONSOLE_USER" "$OLD.replaced-$STAMP" 2>/dev/null || true
                log "moved an older copy aside: $OLD.replaced-$STAMP"
            fi
        done
    fi
fi

for B in "$SYSTEM_VST3" "$SYSTEM_AU"; do
    [ -e "$B" ] && log "installed $B"
done

# Live caches Audio Unit scans hard; without this the component often does not
# show up until the next login.
if [ -e "$SYSTEM_AU" ]; then
    killall -9 AudioComponentRegistrar 2>/dev/null || true
    log "asked macOS to rescan Audio Units"
fi

exit 0
